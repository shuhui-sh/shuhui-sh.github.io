---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import createSlug from "../lib/createSlug";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const latest = posts.slice(0, 6);
const tagCount = new Set(posts.flatMap((p) => p.data.tags ?? [])).size;
const fmt = (d: Date) =>
  `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, "0")}-${String(d.getDate()).padStart(2, "0")}`;
---

<BaseLayout sideBarActiveItemID="home">
  <section class="pb-10 mt-4">
    <div class="text-sm opacity-70 mb-3">Hey there 👋</div>
    <h1 class="text-4xl md:text-5xl font-bold leading-tight">
      我是 <span class="text-primary">碳基Agent</span>
    </h1>
    <div class="text-xl md:text-2xl font-semibold py-3 opacity-80">
      Android 逆向 · 云游戏 · AI 工程
    </div>
    <p class="text-base md:text-lg opacity-80 max-w-2xl leading-relaxed">
      记录踩过的坑和想明白的事。文章首发于掘金，这里是完整存档。
    </p>
    <div class="mt-7 flex flex-wrap gap-3">
      <a class="btn btn-primary" href="/blog/">读文章</a>
      <a class="btn btn-outline" href="https://github.com/shuhui-sh" target="_blank" rel="noopener">GitHub</a>
      <a class="btn btn-ghost" href="/rss.xml">RSS</a>
    </div>
    <div class="stats stats-vertical sm:stats-horizontal bg-base-200 mt-8 shadow-sm">
      <div class="stat py-3">
        <div class="stat-title text-xs">文章</div>
        <div class="stat-value text-2xl">{posts.length}</div>
      </div>
      <div class="stat py-3">
        <div class="stat-title text-xs">标签</div>
        <div class="stat-value text-2xl">{tagCount}</div>
      </div>
      <div class="stat py-3 hidden sm:block">
        <div class="stat-title text-xs">最近更新</div>
        <div class="stat-value text-2xl">{posts.length ? fmt(posts[0].data.pubDate) : "-"}</div>
      </div>
    </div>
  </section>

  <div class="divider"></div>

  <section class="mb-10">
    <div class="flex items-end justify-between mb-5">
      <h2 class="text-2xl md:text-3xl font-bold">项目</h2>
      <a class="link link-hover text-sm opacity-70" href="/projects">查看全部 →</a>
    </div>
    <div class="grid gap-4 md:grid-cols-3">
      {[1, 2, 3].map(() => (
        <div class="card bg-base-100 border border-dashed border-base-300">
          <figure class="h-28 bg-base-200/50 flex items-center justify-center">
            <span class="text-2xl font-black opacity-20">{"</>"}</span>
          </figure>
          <div class="card-body p-4">
            <h3 class="card-title text-sm opacity-60">待补充：项目名称</h3>
            <p class="text-xs opacity-50">一句话说明项目做什么、你的角色与技术栈。</p>
          </div>
        </div>
      ))}
    </div>
  </section>

  <div class="divider"></div>

  <section>
    <div class="flex items-end justify-between mb-5">
      <h2 class="text-2xl md:text-3xl font-bold">最新文章</h2>
      <a class="link link-hover text-sm opacity-70" href="/blog/">全部 {posts.length} 篇 →</a>
    </div>

    <div class="grid gap-4 md:grid-cols-2">
      {latest.map((post) => (
        <a
          href={`/blog/${createSlug(post.data.title, post.slug)}`}
          class="group card bg-base-100 border border-base-300 transition-all duration-200 hover:shadow-xl hover:-translate-y-0.5"
        >
          {post.data.heroImage ? (
            <figure class="h-48 overflow-hidden bg-base-200/60 flex items-center justify-center p-2">
              <img
                src={post.data.heroImage}
                alt={post.data.title}
                loading="lazy"
                class="max-w-full max-h-full object-contain rounded transition-transform duration-300 group-hover:scale-[1.02]"
              />
            </figure>
          ) : (
            <div class="h-48 bg-gradient-to-br from-primary/15 via-base-200 to-secondary/20 flex flex-col items-center justify-center gap-2 px-6">
              <span class="text-4xl font-black opacity-20">{"</>"}</span>
              <span class="text-xs opacity-50 tracking-widest uppercase">{(post.data.tags ?? [])[0] ?? "技术"}</span>
            </div>
          )}
          <div class="card-body p-5">
            <h3 class="card-title text-base leading-snug group-hover:text-primary transition-colors">
              {post.data.title}
            </h3>
            <p class="text-sm opacity-70 line-clamp-2 leading-relaxed">{post.data.description}</p>
            <div class="flex items-center justify-between mt-2">
              <div class="flex flex-wrap gap-1.5">
                {(post.data.tags ?? []).slice(0, 3).map((t) => (
                  <span class="badge badge-outline badge-sm">{t}</span>
                ))}
              </div>
              <time class="text-xs opacity-50 whitespace-nowrap">{fmt(post.data.pubDate)}</time>
            </div>
          </div>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
